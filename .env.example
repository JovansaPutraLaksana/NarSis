APP_NAME=NarSis
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://narsis.test
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Supabase PostgreSQL. Gunakan connection string dari Supabase Connect.
DB_CONNECTION=pgsql
DB_URL=
DB_SCHEMA=laravel
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# local untuk development; supabase untuk deployment/serverless.
NARSIS_STORAGE_DRIVER=local
NARSIS_UPLOAD_MAX_KB=4096
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=narsis-private

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@narsis.local"
MAIL_FROM_NAME="${APP_NAME}"

# Akun Admin Website awal untuk php artisan db:seed
NARSIS_ADMIN_NAME="Administrator Website"
NARSIS_ADMIN_EMAIL=admin@narsis.test
NARSIS_ADMIN_PASSWORD=ChangeMe123!
